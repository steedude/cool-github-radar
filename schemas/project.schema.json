{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/steedude/cool-github-radar/blob/main/schemas/project.schema.json",
  "title": "Cool GitHub Radar project database",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "projects"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_id",
        "repository",
        "canonical_url",
        "status",
        "added_at",
        "first_shared_at",
        "categories",
        "score",
        "notes"
      ],
      "properties": {
        "github_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "GitHub repository numeric ID; seed enrichment前可為 null。"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\\\s]+/[^/\\\\s]+$"
        },
        "canonical_url": {
          "type": "string",
          "pattern": "^https://github\\\\.com/[^/]+/[^/]+/?$"
        },
        "status": {
          "enum": [
            "seed",
            "shared",
            "rejected",
            "follow_up"
          ]
        },
        "added_at": {
          "type": "string",
          "format": "date"
        },
        "first_shared_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
